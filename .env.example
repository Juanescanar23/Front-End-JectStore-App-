# Bagisto API Configuration
NEXT_PUBLIC_BAGISTO_GRAPHQL_ENDPOINT=/graphql
NEXT_PUBLIC_BAGISTO_STOREFRONT_KEY=your_storefront_key_here

# NextAuth Configuration
NEXT_PUBLIC_NEXT_AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_next_auth_secret_here

# Application Settings
COMPANY_NAME=Your Company Name

# Storefront runtime: separate editor availability from explicit publication.
STOREFRONT_EXPERIENCES_ENABLED=false
# pilot (default): exact canonical domains below; an empty list enables none.
# backend-registered: resolve all current/future domains through Laravel's tenant
# registry at the fixed backend origin. This is not a wildcard authorization.
STOREFRONT_EXPERIENCE_HOST_POLICY=pilot
STOREFRONT_EXPERIENCE_HOSTS=
