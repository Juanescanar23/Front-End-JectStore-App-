# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Exported builds have no .git boundary. Keep source directories traversable
# when Tailwind 4 inherits an ancestor ignore-all rule; file exclusions stay below.
!/src/
!/src/**/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


~
